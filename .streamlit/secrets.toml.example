# Notion API 설정
# 1. https://www.notion.so/my-integrations 에서 새 Integration 생성
# 2. Integration Token을 아래에 입력
# 3. Notion 데이터베이스 생성 후 Integration 연결
# 4. 데이터베이스 ID를 아래에 입력

NOTION_TOKEN = "your-notion-integration-token-here"
NOTION_DATABASE_ID = "your-notion-database-id-here"

# ───────────────────────────────────────────────
# Notion 데이터베이스에 필요한 속성(Properties):
# ───────────────────────────────────────────────
# - 공고명 (Title)          ← 필수
# - 링크 (URL)
# - 지원기업 (Text)
# - 지원 마감일 (Date)
# - 직군 (Select)           ← 대학교 행정직, 교직원, 은행, 유학 등
# - 직무 (Text)
# - 근무형태 (Select)       ← 정규직, 계약직, 인턴 등
# - 급여 (Text)
# - 담당업무 (Text)
# - 근무시간 (Text)
# - 근무예정일 (Text)
# - 근무기간 (Text)
# - 지원상태 (Select)       ← 접수 전, 서류접수, 면접 등
